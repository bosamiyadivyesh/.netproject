@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-body">

                    <h2 class="text-center mb-4">
                        Login
                    </h2>

                    <form asp-controller="User"
                          asp-action="Login"
                          method="post">

                        <!-- Email -->
                        <div class="mb-3">

                            <label for="email"
                                   class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   required />

                        </div>


                        <!-- Password -->
                        <div class="mb-3">

                            <label for="password"
                                   class="form-label">
                                Password
                            </label>

                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   required />

                        </div>


                        <!-- Error Message -->
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">
                                @ViewBag.Error
                            </div>
                        }


                        <!-- Login Button -->
                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary">
                                Login
                            </button>

                        </div>

                    </form>


                    <!-- Register Link -->
                    <div class="text-center mt-3">

                        <p>
                            Don't have an account?

                            <a asp-controller="User"
                               asp-action="Register">
                                Register
                            </a>
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>