@model TaskManagement.Models.UserUpdateStatusViewModel

@{
    ViewData["Title"] = "Update Status";
    Layout = "_UserLayout";
}

<h1>Update Status: @Model.TaskTitle</h1>

<form asp-controller="UserTasks" asp-action="UpdateStatus" asp-route-id="@Model.TaskId" method="post">
    <input type="hidden" asp-for="TaskId" />
    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Status"></label>
        <select asp-for="Status">
            <option value="pending">Pending</option>
            <option value="in_progress">In Progress</option>
            <option value="cancelled">Cancelled</option>
        </select>
        <span asp-validation-for="Status"></span>
    </div>
    <p><small>To mark this task as completed, use "Mark as Completed" on the task details page instead.</small></p>

    <div style="display:flex; gap:10px; align-items:center">
        <button type="submit"><i class="bi bi-check2"></i> Save</button>
        <a asp-controller="UserTasks" asp-action="Details" asp-route-id="@Model.TaskId">Cancel</a>
    </div>
</form>
