@model TaskManagement.Models.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_UserLayout";
}

<h1>My Profile</h1>
<p>Update your account details and password.</p>

@if (TempData["Success"] != null)
{
    <p style="color:green">@TempData["Success"]</p>
}

<form asp-controller="UserProfile" asp-action="Index" method="post">
    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="NewPassword">New Password</label>
        <input asp-for="NewPassword" type="password" />
        <small>Leave blank to keep your current password.</small>
        <span asp-validation-for="NewPassword"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword">Confirm New Password</label>
        <input asp-for="ConfirmPassword" type="password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <ul>
        <li>Role: @Model.Role</li>
        <li>Member Since: @Model.CreatedAt.ToString("yyyy-MM-dd")</li>
    </ul>

    <button type="submit"><i class="bi bi-check2"></i> Save Changes</button>
</form>
