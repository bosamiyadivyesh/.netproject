@model List<TaskManagement.Models.AdminCompletionListRow>
@using TaskManagement.Models

@{
    ViewData["Title"] = "Task Completions";
    Layout = "_AdminLayout";
    var taskOptions = ViewBag.TaskOptions as List<TaskOption>;
    var userOptions = ViewBag.UserOptions as List<UserOption>;
}

<h1>Task Completions</h1>

@if (TempData["Success"] != null)
{
    <p style="color:green">@TempData["Success"]</p>
}

<form method="get" asp-controller="AdminTaskCompletions" asp-action="Index">
    <select name="taskId">
        <option value="">All Tasks</option>
        @if (taskOptions != null)
        {
            foreach (var t in taskOptions)
            {
                <option value="@t.TaskId" selected="@(ViewBag.TaskId == t.TaskId)">#@t.TaskId - @t.Title</option>
            }
        }
    </select>

    <select name="userId">
        <option value="">All Users</option>
        @if (userOptions != null)
        {
            foreach (var u in userOptions)
            {
                <option value="@u.Id" selected="@(ViewBag.UserId == u.Id)">@u.Name</option>
            }
        }
    </select>

    <label>From: <input type="date" name="fromDate" value="@ViewBag.FromDate" /></label>
    <label>To: <input type="date" name="toDate" value="@ViewBag.ToDate" /></label>

    <select name="hasPdf">
        <option value="">All</option>
        <option value="true" selected="@(ViewBag.HasPdf == true)">With PDF</option>
        <option value="false" selected="@(ViewBag.HasPdf == false)">Without PDF</option>
    </select>

    <button type="submit">Filter</button>
    <a asp-controller="AdminTaskCompletions" asp-action="Index">Reset</a>
</form>

<table border="1" cellpadding="4">
    <thead>
        <tr>
            <th>Id</th>
            <th>Task</th>
            <th>Task Status</th>
            <th>Project</th>
            <th>Completed By</th>
            <th>Completed At</th>
            <th>PDF</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CompletionId</td>
                <td>
                    <a asp-controller="AdminTasks" asp-action="Details" asp-route-id="@c.TaskId">#@c.TaskId - @c.TaskTitle</a>
                </td>
                <td>@c.TaskStatus</td>
                <td>@(c.ProjectName ?? "-")</td>
                <td>@(c.CompletedByName ?? "-")</td>
                <td>@c.CompletedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (!string.IsNullOrEmpty(c.PdfUrl))
                    {
                        <a href="@c.PdfUrl" target="_blank">View PDF</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>@(string.IsNullOrEmpty(c.Notes) ? "-" : (c.Notes.Length > 40 ? c.Notes.Substring(0, 40) + "..." : c.Notes))</td>
                <td>
                    <a asp-controller="AdminTaskCompletions" asp-action="Details" asp-route-id="@c.CompletionId">Details</a>
                    |
                    <a asp-controller="AdminTaskCompletions" asp-action="Delete" asp-route-id="@c.CompletionId">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="9">No completion records found.</td></tr>
        }
    </tbody>
</table>
